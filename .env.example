APP_ENV=development
# DATABASE_URL=sqlite:///./fahm.db
# JWT_SECRET=replace-with-a-random-value-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000/api/v1
MODEL_BACKEND=gemini
# Place GEMINI_API_KEY= in apps/api/.env so Next.js cannot load it.
GEMINI_DIAGNOSIS_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=
# LLM_MODEL_REVISION=
LLM_THINK=false
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9
LLM_TOP_K=20
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
DEMO_MODE=false
# DEMO_ADMIN_SECRET=replace-with-a-separate-random-value

# Documents de cours (voir docs/DOCUMENTS.md). Exigent PostgreSQL et un stockage S3 privé.
# DATABASE_URL=postgresql+psycopg://neurvia:<mot-de-passe>@127.0.0.1:55432/neurvia
# DOCUMENT_S3_ENDPOINT=http://127.0.0.1:59000
# DOCUMENT_S3_BUCKET=neurvia-documents
# DOCUMENT_S3_ACCESS_KEY=
# DOCUMENT_S3_SECRET_KEY=
# DOCUMENT_MAX_UPLOAD_MB=24
# DOCUMENT_MAX_PAGES=120
# DOCUMENT_OCR_LANGUAGES=eng+fra+ara
# DOCUMENT_VISION_ENABLED=true
DOCUMENT_VISION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# RAG_CONTEXT_BUDGET=5500

# Serveur de modèles : ollama ou openai (vLLM ou autre serveur compatible OpenAI).
# Sélection explicite pour Ollama : MODEL_BACKEND=ollama, puis ajustez les trois noms de modèles.
# MODEL_API_KEY=
# EMBEDDING_REVISION=
