APP_ENV=development
# DATABASE_URL=sqlite:///./fahm.db
# JWT_SECRET=replace-with-a-random-value-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000/api/v1
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
# LLM_FALLBACK_MODEL=qwen3.5:4b
LLM_THINK=false
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9
LLM_TOP_K=20
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
DEMO_MODE=false
# DEMO_ADMIN_SECRET=replace-with-a-separate-random-value
